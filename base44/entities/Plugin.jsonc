{
  "name": "Plugin",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "code": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "author_name": {
      "type": "string",
      "default": ""
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": "system"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "settings_schema": {
      "type": "object",
      "default": {}
    },
    "install_count": {
      "type": "number",
      "default": 0
    },
    "team_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}