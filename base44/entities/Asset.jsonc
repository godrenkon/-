{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "tileset",
        "character",
        "bgm",
        "se",
        "effect",
        "background"
      ]
    },
    "file_url": {
      "type": "string",
      "minLength": 1
    },
    "thumbnail": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "license": {
      "type": "string",
      "default": "free_use"
    },
    "team_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name",
    "type",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}