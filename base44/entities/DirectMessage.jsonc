{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "team_id": {
      "type": "string",
      "default": ""
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    }
  }
}